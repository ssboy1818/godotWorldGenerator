[configuration]

entry_symbol = "worldgen_library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]

linux.debug.x86_32 = "res://addons/worldgen/bin/libworldgen.linux.template_debug.x86_32.so"
linux.release.x86_32 = "res://addons/worldgen/bin/libworldgen.linux.template_release.x86_32.so"
linux.debug.x86_64 = "res://addons/worldgen/bin/libworldgen.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/worldgen/bin/libworldgen.linux.template_release.x86_64.so"
linux.debug.arm32 = "res://addons/worldgen/bin/libworldgen.linux.template_debug.arm32.so"
linux.release.arm32 = "res://addons/worldgen/bin/libworldgen.linux.template_release.arm32.so"
linux.debug.arm64 = "res://addons/worldgen/bin/libworldgen.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/worldgen/bin/libworldgen.linux.template_release.arm64.so"
linux.debug.rv64 = "res://addons/worldgen/bin/libworldgen.linux.template_debug.rv64.so"
linux.release.rv64 = "res://addons/worldgen/bin/libworldgen.linux.template_release.rv64.so"
windows.debug.x86_32 = "res://addons/worldgen/bin/libworldgen.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://addons/worldgen/bin/libworldgen.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://addons/worldgen/bin/libworldgen.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/worldgen/bin/libworldgen.windows.template_release.x86_64.dll"
windows.debug.arm64 = "res://addons/worldgen/bin/libworldgen.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://addons/worldgen/bin/libworldgen.windows.template_release.arm64.dll"
macos.debug = "res://addons/worldgen/bin/libworldgen.macos.template_debug.framework"
macos.release = "res://addons/worldgen/bin/libworldgen.macos.template_release.framework"
